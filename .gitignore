node_modules/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/all-blob-reports/
/playwright/.cache/

# K6 (directory itself is tracked via .gitkeep — k6's handleSummary() can't
# create it, so it must already exist before `k6 run` writes into it)
/k6-reports/*
!/k6-reports/.gitkeep

# Local env files may contain credentials and must never be committed.
.env
.env.local
.env.*.local

# OS / editor
.DS_Store

# Claude Code session state (not project source)
.claude/
